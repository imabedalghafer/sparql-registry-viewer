{
  "_comment": "Shared contract for the read-only gate. BOTH the browser (web/rdf.js) and the proxy (server.py) must classify every case identically — divergence is how a bypass gets in. Consumed by test/rdf.test.mjs and test/test_server.py.",
  "cases": [
    { "why": "prefix named after a form must not masquerade as it (v0.1 blocker)",
      "query": "PREFIX select: <http://x#> INSERT DATA { <http://a> <http://b> <http://c> }",
      "form": "INSERT", "readonly": false },
    { "why": "same bypass, DELETE",
      "query": "PREFIX construct: <http://x#> DELETE WHERE { ?s ?p ?o }",
      "form": "DELETE", "readonly": false },
    { "why": "several decoy prefixes then an update",
      "query": "PREFIX describe: <http://x#> PREFIX ask: <http://y#> LOAD <http://z>",
      "form": "LOAD", "readonly": false },
    { "why": "'#' inside an IRI is not a comment",
      "query": "PREFIX eli: <http://data.europa.eu/eli/ontology#> SELECT * WHERE { ?s ?p ?o }",
      "form": "SELECT", "readonly": true },
    { "why": "a comment cannot disguise an update",
      "query": "# SELECT nothing\nINSERT DATA { <http://a> <http://b> 1 }",
      "form": "INSERT", "readonly": false },
    { "why": "multiple comment lines then an update",
      "query": "#SELECT\n#CONSTRUCT\nDROP GRAPH <http://g>",
      "form": "DROP", "readonly": false },
    { "why": "update keyword inside a literal stays a read query",
      "query": "SELECT ?s WHERE { ?s <http://p> \"DELETE me\" } LIMIT 1",
      "form": "SELECT", "readonly": true },
    { "why": "update-looking literal content is harmless",
      "query": "SELECT ?s WHERE { ?s <http://p> \"INSERT DATA { }\" }",
      "form": "SELECT", "readonly": true },
    { "why": "WITH-form update",
      "query": "WITH <http://g> DELETE { ?s ?p ?o } WHERE { ?s ?p ?o }",
      "form": "WITH", "readonly": false },
    { "why": "graph management updates", "query": "CLEAR GRAPH <http://g>", "form": "CLEAR", "readonly": false },
    { "why": "graph copy", "query": "COPY <http://a> TO <http://b>", "form": "COPY", "readonly": false },
    { "why": "graph move", "query": "MOVE DEFAULT TO <http://b>", "form": "MOVE", "readonly": false },
    { "why": "graph add", "query": "ADD <http://a> TO <http://b>", "form": "ADD", "readonly": false },
    { "why": "graph create", "query": "CREATE GRAPH <http://g>", "form": "CREATE", "readonly": false },
    { "why": "load into graph", "query": "LOAD <http://data> INTO GRAPH <http://g>", "form": "LOAD", "readonly": false },
    { "why": "plain select", "query": "SELECT * WHERE { ?s ?p ?o }", "form": "SELECT", "readonly": true },
    { "why": "leading whitespace and newlines",
      "query": "  \n\t CONSTRUCT { ?s ?p ?o } WHERE { ?s ?p ?o }", "form": "CONSTRUCT", "readonly": true },
    { "why": "ask", "query": "ASK { ?s ?p ?o }", "form": "ASK", "readonly": true },
    { "why": "describe", "query": "DESCRIBE <http://example.org/x>", "form": "DESCRIBE", "readonly": true },
    { "why": "BASE plus PREFIX prologue",
      "query": "BASE <http://x/> PREFIX p: <http://y#> SELECT * WHERE { ?s ?p ?o }",
      "form": "SELECT", "readonly": true },
    { "why": "UTF-8 BOM before the query", "query": "﻿SELECT * WHERE { ?s ?p ?o }", "form": "SELECT", "readonly": true },
    { "why": "empty input fails closed", "query": "", "form": "UNKNOWN", "readonly": false },
    { "why": "gibberish fails closed", "query": "gibberish", "form": "UNKNOWN", "readonly": false },
    { "why": "lowercase update still refused", "query": "insert data { <http://a> <http://b> 1 }", "form": "INSERT", "readonly": false },
    { "why": "prefix with empty name (:) then update",
      "query": "PREFIX : <http://x#> INSERT DATA { <http://a> <http://b> 1 }", "form": "INSERT", "readonly": false }
  ]
}
